# ACT LEAPS LLM key template. Copy this file to `act_llm_secrets.sh` on the run
# machine (that copy is gitignored, so the key never enters this public repo).
# run_instance.sh sources it and then runs the LEAPS `gain+llm` search; with no key
# set it stays on the offline `gain` config. Use the exact env var the openrouter
# backend reads. This is the "post-install / machine-specific setup" step.
export OPENROUTER_API_KEY=sk-or-REPLACE_ME
